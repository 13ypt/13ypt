af.org/viaf/242059233","http://viaf.org/viaf/125499078","https://d-nb.info/gnd/4000556-2","http://id.loc.gov/authorities/names/n80061791","http://data.bnf.fr/ark:/12148/cb11863530z","http://data.bnf.fr/ark:/12148/cb15238583n","http://data.bnf.fr/ark:/12148/cb11938556d","http://www.idref.fr/027316866/id","http://www.idref.fr/026375680/id","http://id.ndl.go.jp/auth/ndlna/00562068","http://id.nlm.nih.gov/mesh/D004534","https://www.freebase.com/m/02k54","https://g.co/kg/m/02k54","http://id.nlm.nih.gov/mesh/Z01.058.266.317","http://datos.bne.es/resource/XX450764","https://livedata.bibsys.no/authority/90074621","https://sws.geonames.org/357994/","http://vocab.getty.edu/tgn/7016833","http://id.worldcat.org/fast/1208755","http://www.yso.fi/onto/yso/p105841","http://babelnet.org/rdf/s00005255n","http://nomisma.org/id/egypt","http://zbw.eu/stw/descriptor/17745-0","http://vocabularies.unesco.org/thesaurus/concept706","http://www.yso.fi/onto/ysa/Y105841","http://dbpedia.org/resource/Egypt"]}],"providedCHOs":[{"about":"/item/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a"}],"proxies":[{"about":"/proxy/europeana/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a","dcCoverage":{"def":["http://data.europeana.eu/place/32"]},"dcIdentifier":{"def":["http://data.collectienederland.nl/resource/document/rijksmuseum-van-oudheden/AMM16a"]},"dcType":{"def":["http://data.europeana.eu/concept/1910"]},"dctermsMedium":{"def":["http://data.europeana.eu/concept/1910"]},"proxyIn":["/aggregation/europeana/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a"],"proxyFor":"/item/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a","lineage":["/proxy/provider/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a"],"edmType":"IMAGE","europeanaProxy":true},{"about":"/proxy/provider/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a","dcCoverage":{"def":["Egypte"]},"dcDate":{"def":["Late Periode ; Grieks-Romeinse Periode 500 v.Chr.-300 n.Chr."]},"dcDescription":{"def":["krokodil; mummie The mummy has been reinforced by a bundle of vegetable stalks (visible through holes in the back and tail) and at least one wooden stick (protruding at the caudal end), bound together with numerous concentric windings of palm rope. It was then wrapped in a large sheet of medium-fine natural-coloured linen (warp-faced tabby weave, about 14 x 20 threads/cm2). The ends have been tucked in and fixed by means of a few stitches (head end) and windings (tail) of coarse string. Two bulbous eyes have been modelled as protrusions on the head. There are various irregular strips or patches of linen, mainly on the back. The whole mummy was finally wrapped in a large sheet of dark brown linen; this shroud still remains at tail and head end, but has largely disappeared over the central part of the body. It has been fixed by means of a long strap of about 2 cm wide, not torn from a larger cloth but woven as such with two selvages; this winds around the mummy in spiral fashion and back again, displaying X-shaped crossings on part of the back of the mummy. On the ventral side, however, the windings have been drawn together in groups of two to four by two longitudinal straps passing along the full length of the mummy. The mummy was extensively restored in 1996 and is now covered in modern gauze for further protection."]},"dcIdentifier":{"def":["AMM 16a"]},"dcRights":{"def":["Creative Commons By-licensie: bron: Rijksmuseum van Oudheden, Leiden"]},"dcSubject":{"def":["Mummie van een krokodil"]},"dcTitle":{"def":["mummie ; reptiel ; krokodil ; dierenmummie"]},"dcType":{"def":["mummie ; reptiel ; krokodil ; dierenmummie","mummie"]},"dctermsCreated":{"def":["Late Periode ; Grieks-Romeinse Periode 500 v.Chr.-300 n.Chr."]},"dctermsExtent":{"def":["314 x 28,5 x 20,5 cm"]},"dctermsIsReferencedBy":{"def":["Leemans, Description raisonnée (1840) N 28 Boeser, Catalogus (1907) E.XLV.29 M.J. Raven/W.K. Taconis, Egyptian mummies (Turnhout 2005), cat. 113 Holwerda, Dierenmummies (2008), 50-1 P. Piacentini/Chr. Orsenigo, Egitto. La straordinaria scoperta del Faraone Amenofi II (Milan 2017), p. 162 (foutief genoemd AMM 16k, die toen idd in bruikleen is geweest). Topstukken van het RMO, Leiden 2020, p. 56-57"]},"dctermsMedium":{"def":["mummie","hout ; organisch ; mummie (dierlijk) ; linnen ; riet"]},"proxyIn":["/aggregation/provider/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a"],"proxyFor":"/item/2021606/resource_document_rijksmuseum_van_oudheden_AMM16a","edmType":"IMAGE","europeanaProxy":false}],"timestamp_created":"2024-03-06T11:01:28.214Z","timestamp_created_epoch":1709722888214,"timestamp_update":"2024-03-06T11:01:28.214Z","timestamp_update_epoch":1709722888214,"type":"IMAGE"}}