},"latitude":27.0,"longitude":29.0,"owlSameAs":["http://www.wikidata.org/entity/Q79","http://viaf.org/viaf/242059233","http://viaf.org/viaf/125499078","https://d-nb.info/gnd/4000556-2","http://id.loc.gov/authorities/names/n80061791","http://data.bnf.fr/ark:/12148/cb11863530z","http://data.bnf.fr/ark:/12148/cb15238583n","http://data.bnf.fr/ark:/12148/cb11938556d","http://www.idref.fr/027316866/id","http://www.idref.fr/026375680/id","http://id.ndl.go.jp/auth/ndlna/00562068","http://id.nlm.nih.gov/mesh/D004534","https://www.freebase.com/m/02k54","https://g.co/kg/m/02k54","http://id.nlm.nih.gov/mesh/Z01.058.266.317","http://datos.bne.es/resource/XX450764","https://livedata.bibsys.no/authority/90074621","https://sws.geonames.org/357994/","http://vocab.getty.edu/tgn/7016833","http://id.worldcat.org/fast/1208755","http://www.yso.fi/onto/yso/p105841","http://babelnet.org/rdf/s00005255n","http://nomisma.org/id/egypt","http://zbw.eu/stw/descriptor/17745-0","http://vocabularies.unesco.org/thesaurus/concept706","http://www.yso.fi/onto/ysa/Y105841","http://dbpedia.org/resource/Egypt"]}],"providedCHOs":[{"about":"/item/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3"}],"proxies":[{"about":"/proxy/europeana/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3","dcCoverage":{"def":["http://data.europeana.eu/place/32"]},"dcIdentifier":{"def":["http://data.collectienederland.nl/resource/document/rijksmuseum-van-oudheden/F1998-11.3"]},"proxyIn":["/aggregation/europeana/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3"],"proxyFor":"/item/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3","lineage":["/proxy/provider/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3"],"edmType":"IMAGE","europeanaProxy":true},{"about":"/proxy/provider/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3","dcCoverage":{"def":["Egypte"]},"dcDate":{"def":["Grieks-Romeinse Periode ; Romeinse keizertijd 1-200 n.Chr."]},"dcDescription":{"def":["krokodillenmummie ; mummie Mummie van een jonge krokodil . Het krokodillenjong is ingewikkeld met onbeschilderd linnen, van een licht geelbruine kleur. Wel zijn er aan de linkerzijde van het hoofdje nog sporen van een beschilderd oog. Over de rug is een aantal banden in lengterichting aangebracht. Deze banden, of misschien plooien, worden op hun plaats gehouden door dwarsbanden ongeveer ter hoogte van de nek, de pootjes en de staart, zodat er zes vakjes ontstaan. De pootjes zijn niet afzonderlijk ingezwachteld. De buikzijde wordt afgedekt door een gladde lap. De bovenste van de drie dwarsbanden, die ter hoogte van de nek, is van een iets donkerder kleur. De mummie is in redelijke staat, maar hier en daar zijn zwakke plekken of losse delen versterkt door concentrische windingen van fijn garen, met name aan de snuit en de staart. De staart heeft een rafelig uiteinde. Plaatselijk zijn de windsels vlekkerig verkleurd."]},"dcIdentifier":{"def":["F 1998/11.3"]},"dcRights":{"def":["Creative Commons By-licensie: bron: Rijksmuseum van Oudheden, Leiden"]},"dcSubject":{"def":["krokodillenmummie"]},"dcTitle":{"def":["mummie ; reptiel ; krokodil ; dierenmummie"]},"dcType":{"def":["mummie ; reptiel ; krokodil ; dierenmummie"]},"dctermsCreated":{"def":["Grieks-Romeinse Periode ; Romeinse keizertijd 1-200 n.Chr."]},"dctermsExtent":{"def":["34,5 x 5,4 x 3,5 cm"]},"dctermsIsReferencedBy":{"def":["M.J. Raven/W.K. Taconis, Egyptian mummies (Turnhout 2005), cat. 119"]},"dctermsMedium":{"def":["organisch ; mummie (dierlijk) ; linnen ; hars"]},"proxyIn":["/aggregation/provider/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3"],"proxyFor":"/item/2021606/resource_document_rijksmuseum_van_oudheden_F1998_11_3","edmType":"IMAGE","europeanaProxy":false}],"timestamp_created":"2024-03-06T11:01:28.214Z","timestamp_created_epoch":1709722888214,"timestamp_update":"2024-03-06T11:01:28.214Z","timestamp_update_epoch":1709722888214,"type":"IMAGE"}}