{"status": 200, "responseCode": 1, "response": {"rows": [{"id": "ld1-1643406825086-1643406835980-0", "title": "Crocodile Modeled Of Terracotta, Red", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8386895", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "29 Jun 1917"}], "name": [{"label": "Donor Name", "content": "John C. Davis"}], "notes": [{"label": "Record Last Modified", "content": "30 Jul 2020"}, {"label": "Specimen Count", "content": "1"}], "place": [{"label": "Place", "content": "Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Ethnology"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "061283"}, {"label": "USNM Number", "content": "E299937-0"}], "objectType": [{"label": "Object Type", "content": "Crocodile"}]}, "indexedStructured": {"date": ["1910s"], "name": ["John C. Davis"], "place": ["Africa", "Egypt"], "topic": ["Crocodiles", "Anthropology", "Ethnology"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}}], "object_type": ["Figures (representations)"], "online_media_type": ["Images"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/39d5ea08b-ad35-488e-9b70-37c61ec226b2", "title": {"label": "title", "content": "Crocodile Modeled Of Terracotta, Red"}, "record_ID": "nmnhanthropology_8386895", "unit_code": "NMNHANTHRO", "title_sort": "CROCODILE MODELED OF TERRACOTTA RED", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/39d5ea08b-ad35-488e-9b70-37c61ec226b2", "metadata_usage": {"access": "CC0"}}}, "hash": "6e2aa3f954a0b993d8d6a304ee2abfbe29253cd7", "docSignature": "598a8df17639a11aa3b2afd9139be243", "timestamp": "1663781739", "lastTimeUpdated": "1734465880", "version": "1734438751"}, {"id": "ld1-1643407023501-1643407060748-0", "title": "Mummied Crocodile", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8314204", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "1885"}], "name": [{"label": "Donor Name", "content": "Dr. George W. Samson"}, {"label": "Site Name", "content": "Thebes"}], "notes": [{"label": "Notes", "content": "From NMNH Exhibit Hall \"Eternal Life in Ancient Egypt\" label for this artifact, 2011: Mummified crocodile, 332-30 B.C. Priests took great care with these wrappings, modeling the head, nostrils and eyes in linen and covering the body in a crisscross pattern secured by linen thread. The remains inside look less impressive: a flattened crocodile, possibly a hatchling, covered with resin."}, {"label": "Record Last Modified", "content": "20 Aug 2017"}, {"label": "Specimen Count", "content": "1"}], "place": [{"label": "Place", "content": "Qena, Upper Egypt, Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Archaeology"}], "culture": [{"label": "Culture", "content": "Ancient Egyptian"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "015645"}, {"label": "USNM Number", "content": "A74579-0"}], "objectType": [{"label": "Object Type", "content": "Animal Mummy"}]}, "indexedStructured": {"date": ["1880s"], "name": ["Dr. George W. Samson"], "place": ["Qena", "Africa", "Egypt", "Upper Egypt"], "topic": ["Archaeology", "Anthropology"], "culture": ["Egyptians"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}, "L3": {"type": "State", "content": "Upper Egypt"}, "L4": {"type": "County", "content": "Qena"}}], "object_type": ["Animals", "Mummies"], "online_media_type": ["Images"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/316ca3ab2-b419-49f7-be87-a0961d53fc75", "title": {"label": "title", "content": "Mummied Crocodile"}, "record_ID": "nmnhanthropology_8314204", "unit_code": "NMNHANTHRO", "title_sort": "MUMMIED CROCODILE", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/316ca3ab2-b419-49f7-be87-a0961d53fc75", "metadata_usage": {"access": "CC0"}}}, "hash": "6070cfe52d6cbc451bfa37a5bc6c510e91d17fa0", "docSignature": "47af975bec15f2446ed151b1435ac389", "timestamp": "1663781739", "lastTimeUpdated": "1734465139", "version": "1734438687"}, {"id": "ld1-1643407023501-1643407064923-0", "title": "Mummified Reptiles", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8325979", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "1991"}], "name": [{"label": "Donor Name", "content": "No Information"}], "notes": [{"label": "Notes", "content": "ONE BOX OF MUMMIFIED REPTILES (INCL. CROCODILES) WITH TEXTILE WRAPPINGS. MIGHT BE FROM CATALOGUE #S 1563 - 1565?"}, {"label": "Notes", "content": "From NMNH Exhibit Hall \"Eternal Life in Ancient Egypt\" label for 4 crocodile mummies with this number, 2011: Mummified crocodile group, 332 B.C.-A.D. 250. Dozens of crocodile hatchlings emerge from the nest together, and mummy groups like these that mimic nature were fairly common. The varied quality of the linen wrappings probably means that priests used leftover bits of fabric to wrap the crocodiles."}, {"label": "Record Last Modified", "content": "18 Oct 2017"}, {"label": "Specimen Count", "content": "50"}], "place": [{"label": "Place", "content": "Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Archaeology"}], "culture": [{"label": "Culture", "content": "Ancient Egyptian"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "999999"}, {"label": "USNM Number", "content": "AT5604-0"}], "objectType": [{