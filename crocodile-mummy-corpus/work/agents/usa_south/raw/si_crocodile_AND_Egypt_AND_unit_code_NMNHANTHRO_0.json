s"], "place": ["Africa", "Egypt"], "topic": ["Anthropology", "Ethnology"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}}], "object_type": ["Figures (representations)"], "online_media_type": ["Images"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/3a0eb440c-9788-4bd8-add2-7734d5c2f8e3", "title": {"label": "title", "content": "Crocodile Modeled Of Terracotta, Black"}, "record_ID": "nmnhanthropology_8386894", "unit_code": "NMNHANTHRO", "title_sort": "CROCODILE MODELED OF TERRACOTTA BLACK", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/3a0eb440c-9788-4bd8-add2-7734d5c2f8e3", "metadata_usage": {"access": "CC0"}}}, "hash": "d22478ee816dc2846d8358ca13ec709c1f75dbaf", "docSignature": "872dfb554f57de546ef69cb2b848c9fb", "timestamp": "1663781739", "lastTimeUpdated": "1734465880", "version": "1734438751"}, {"id": "ld1-1643407100205-1643407144486-0", "title": "Sm. Blue Faience Amulet, The Goddess Tauret", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8110934", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "1932"}], "name": [{"label": "Donor Name", "content": "John V. Hansen"}, {"label": "Site Name", "content": "Luxor (At Or Near)"}], "notes": [{"label": "Notes", "content": "From NMNH Exhibit Hall \"Eternal Life in Ancient Egypt\" label for this artifact, 2011: Taweret amulet, 664-30 B.C. Depicted as a hippo with a crocodile tail, Taweret was associated with childbirth. She performed a related role in rebirth of the dead."}, {"label": "Record Last Modified", "content": "12 Mar 2018"}, {"label": "Specimen Count", "content": "1"}], "place": [{"label": "Place", "content": "Qena, Upper Egypt, Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Archaeology"}], "culture": [{"label": "Culture", "content": "Ancient Egyptian"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "117443"}, {"label": "USNM Number", "content": "A363211-0"}], "objectType": [{"label": "Object Type", "content": "Amulet"}]}, "indexedStructured": {"date": ["1930s"], "name": ["John V. Hansen"], "place": ["Qena", "Africa", "Egypt", "Upper Egypt"], "topic": ["Archaeology", "Anthropology"], "culture": ["Egyptians"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}, "L3": {"type": "State", "content": "Upper Egypt"}, "L4": {"type": "County", "content": "Qena"}}], "object_type": ["Amulets"], "online_media_type": ["Images"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/3495d418b-0458-492c-9cc3-fa25ac66960b", "title": {"label": "title", "content": "Sm. Blue Faience Amulet, The Goddess Tauret"}, "record_ID": "nmnhanthropology_8110934", "unit_code": "NMNHANTHRO", "title_sort": "SM BLUE FAIENCE AMULET THE GODDESS TAURET", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/3495d418b-0458-492c-9cc3-fa25ac66960b", "metadata_usage": {"access": "CC0"}}}, "hash": "529050d82e9eb3b5fdd627c8c725cba59b467475", "docSignature": "01dbf7353f43d07ca96fefdd22ba93f4", "timestamp": "1663781635", "lastTimeUpdated": "1734466394", "version": "1734438821"}, {"id": "ld1-1643406825086-1643406871350-1", "title": "Necklace", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8457973", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "19 Oct 1988"}, {"label": "Collection Date", "content": "1965 to 1966"}], "name": [{"label": "Collector", "content": "Alixa Naff"}, {"label": "Donor Name", "content": "George Naff"}], "notes": [{"label": "Notes", "content": "Double hinged chain with 20 coins attached. Pendant of animal shape resembling a crocodile, with 3 chains attached. 6 pendants attached to chains: 3 floral, 3 crescents. Modern clasp. Arabic stamps near clasp. Worn by women. The layered coins represent wealth. Purchased by collector from Cairo dealer."}, {"label": "Record Last Modified", "content": "31 Jul 2020"}, {"label": "Specimen Count", "content": "1"}], "place": [{"label": "Place", "content": "Cairo, Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Ethnology"}], "culture": [{"label": "Culture", "content": "Egyptian"}, {"label": "Culture", "content": "Arabic-Islamic"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "378937"}, {"label": "USNM Number", "content": "E424829-0"}], "objectType": [{"label": "Object Type", "content": "Necklace"}], "physicalDescription": [{"label": "Length", "content": "58 cm"}]}, "indexedStructured": {"date": ["1960s", "1980s"], "name": ["Alixa Naff", "George Naff"], "place": ["Cairo", "Africa", "Egypt"], "topic": ["Anthropology", "Ethnology"], "culture": ["Muslims", "Egyptians", "Arabs"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}, "L5": {"type": "City", "content": "Cairo"}}], "object_type": ["Necklaces"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/338312883-1e46-470c-8f49-a5729b5da15b", "title": {"label": "title", "content": "Necklace"}, "record_ID": "nmnhanthropology_8457973", "unit_code": "NMNHANTHRO", "title_sort": "NECKLACE", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/338312883-1e46-470c-8f49-a5729b5da15b", "metadata_usage": {"access": "CC0"}}}, "hash": "98d9d527569c5e834d06c1f43ad15fd60795d828", "docSignature": "e7e883f638d61e7831f36d45b8369ee2", "timestamp": "1663781413", "lastTimeUpdated": "1726095605", "version": "1725971297"}, {"id": "ld1-1643406903964-1643406927609-1", "title": "Black Stone Cippus", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8188792", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "15 Feb 1963"}], "name": [{"label": "Donor Name", "content": "Mortimer Clarke"}], "notes": [{"label": "Notes", "content": "A \"chippus\" [term from Greek] or protective amulet. Stone, probably steatite. Has ritual text inscribed on the back. Also has holes drilled through - placement (through relief images) indicates these are secondary modern damage, not original. This one shows a female deity holding (subduing) scorpions and snakes and maybe other critters, while standing on a crocodile. Late period c.600-300 BC. An object of popular piety, would have been common in homes of average means."}, {"label": "Notes", "content": "From card: \"Front with standing figure in relief, holding sistrum in each hand; lion to left, scarab to right. Inscription on back, perforated at top and bottom. May be fraud.\""}, {"label": "Record Last Modified", "content": "15 Aug 2026"}, {"label": "Specimen Count", "content": "1"}], "place": [{"label": "Place", "content": "Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Archaeology"}], "culture": [{"label": "Culture", "content": "Egyptian, Late Period"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "245919"}, {"label": "USNM Number", "content": "A435213-0"}], "objectType": [{"label": "Object Type", "content": "Stela"}]}, "indexedStructured": {"date": ["1960s"], "name": ["Mortimer Clarke"], "place": ["Africa", "Egypt"], "topic": ["Archaeology", "Anthropology"], "culture": ["Egyptian, Late Period"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}}], "object_type": ["Stelae"], "online_media_type": ["Images"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/35288b752-10e9-4b74-9ba3-00315dc97fda", "title": {"label": "title", "content": "Black Stone Cippus"}, "record_ID": "nmnhanthropology_8188792", "unit_code": "NMNHANTHRO", "title_sort": "BLACK STONE CIPPUS", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/35288b752-10e9-4b74-9ba3-00315dc97fda", "metadata_usage": {"access": "CC0"}}}, "hash": "5ca498bd6c343a4a09a8ba95fcd53dbcb5fe8499", "docSignature": "552bf7e317895f3ea9c76262b6c93e0f", "timestamp": "1663781636", "lastTimeUpdated": "1787764664", "version": "1787741013"}, {"id": "ld1-1643406903964-1643406916537-0", "title": "Small Bull Mummy/1", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8162347", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "4 Jun 1956"}], "name": [{"label": "Collector", "content": "Dr. H. Abbott"}, {"label": "Donor Name", "content": "Brooklyn Museum"}, {"label": "Site Name", "content": "Dashur (Dahshur)"}], "notes": [{"label": "Notes", "content": "From card: \"Late Ptolemaic to Early Roman Period (200 B.C. - 200 A.D.)\" See accession history for detailed info. on collection/donation of this artifact and the others in this collection."}, {"label": "Notes", "content": "From NMNH Exhibit Hall \"Eternal Life in Ancient Egypt\" label for this artifact, 2011: Bull mummy, 300 B.C.-A.D. 400. Although at least nine layers of wrappings protect this bull, the x-ray below reveals only a jumble of bones inside. Some scholars suggest that priests or the king ate the meat to partake of the god's powers. Embalmers mummified the head, however, and held a ritual to allow the bull to see, eat, and hear forever. Divine Bull. This bull lived like a god in a special stable within the temple walls. Priests massaged his body, decorated his horns with ornaments of silver, and even sang to him. Egyptians saw him as a living manifestation of a god, and worshippers filled the temple daily to honor him. When the bull died, Egyptians believed he went on to eternal life, and a young bull with the same distinctive markings took his place. Many temples honored other sacred animals - for example, crocodiles that embodied the god Sobek in the temple at Kom Ombo, and cats of Bastet at Bubastis. When a divine bull died, the entire region fell into mourning. Priests held an elaborate funeral and buried him in an underground niche."}, {"label": "Record Last Modified", "content": "1 Apr 2025"}, {"label": "Specimen Count", "content": "1"}], "place": [{"label": "Place", "content": "Dashur (Dahshur), Lower Egypt, Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Archaeology"}], "culture": [{"label": "Culture", "content": "Late Ptolemaic/Roman"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "209589"}, {"label": "USNM Number", "content": "A413942-0"}], "objectType": [{"label": "Object Type", "content": "Animal Mummy"}], "physicalDescription": [{"label": "Height - Object", "content": "86 cm"}, {"label": "Depth - Object", "content": "89 cm"}, {"label": "Width - Object", "content": "113.5 cm"}]}, "indexedStructured": {"date": ["1950s"], "name": ["Dr. H. Abbott", "Brooklyn Museum"], "place": ["Dashur (Dahshur)", "Africa", "Egypt", "Lower Egypt"], "topic": ["Archaeology", "Anthropology"], "culture": ["Egyptians", "Romans"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}, "L3": {"type": "State", "content": "Lower Egypt"}, "L4": {"type": "County", "content": "Dashur (Dahshur)"}}], "object_type": ["Animals", "Mummies"], "online_media_type": ["Images"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/342451350-d66c-4bd3-b366-ddff424e50ac", "title": {"label": "title", "content": "Small Bull Mummy/1"}, "record_ID": "nmnhanthropology_8162347", "unit_code": "NMNHANTHRO", "title_sort": "SMALL BULL MUMMY1", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/342451350-d66c-4bd3-b366-ddff424e50ac", "metadata_usage": {"access": "CC0"}}}, "hash": "3bbbcfbba54c4828f2079b5564bfe3c316f3dc50", "docSignature": "4744e2222c4da073803e88299d74f4e4", "timestamp": "1663781636", "lastTimeUpdated": "1755728229", "version": "1755685693"}, {"id": "ld1-1643407100205-1643407109934-0", "title": "Inner Coffin & Lid Of Tentkhonsu", "unitCode": "NMNHANTHRO", "type": "edanmdm", "url": "edanmdm:nmnhanthropology_8026581", "content": {"freetext": {"date": [{"label": "Accession Date", "content": "1893"}], "name": [{"label": "Donor Name", "content": "Government Of Egypt"}, {"label": "Site Name", "content": "Deir El-Bahri (Deir el-Bahari,Thebes)"}], "notes": [{"label": "Notes", "content": "From card: \"On floor, the deceased in presence of Osiris. She-God with double head, ram & crocodile. Dr. L. Bull, Met. Mus., New York, identifies this as probable inner coffine of # 154953 since it has same titles & name. He says \"On floor is the goddess of the West, her headdress surmounted by a falcon wearing the atef crown.\" XXI Dynasty. Exhibit, Hall 26, 1976.\" 1978 NMNH slide set caption: \"Inner coffin and lid, wooden, painted with hieroglyphs and ritual scenes, 3-dimensional portrait head at top, belonged to Tenet-Khonsu, chantress of Amon-Ra, Egyptian, Thebes, 21st Dynasty, ca. 1000 B.C.\" See also Catalogue No. 154953, which is outer coffin and lid of Tentkhonsu. Note re photos: Negative # 78-8766 is frontal, lt, overview. 78-8767 is 3/4, lt, overview, shows detail of head. 78-8768 is profile, lt, detail. 78-8769 is frontal, lt overview of both Cat. # 154953 and 154954, the inner and outer coffins and lids."}, {"label": "Notes", "content": "From NMNH Exhibit Hall \"Eternal Life in Ancient Egypt\" label for this artifact, 2011: Inner coffin of Tentkhonsu, 1025-980 B.C. Tentkhonsu's coffin set included this inner coffin, as well as an outer coffin and a board (A154953) to protect the mummy. The set was one of 153 burials from Bab el-Gasus, a tomb chamber in Deir el-Bahari where Egyptians moved the coffins and mummies of elite 21st-dynasty families. The lid presents an idealized portrait of Tentkhonsu. Tentkhonsu's mummy has never been identified. Tentkhonsu means \"She who belongs to the god Khonsu\" - a name that shows she came from an elite Theban family that staffed the city's temples. She sang at festivals, and, like most Egyptian women, probably married by 14 and ran a household. If she reached age 40, she would have outlived many of her contemporaries. Tentkhonsu's coffin was designed to guide her past the dangers of the Netherworld. The coffin interior tells the story of Tentkhonsu's spiritual passage from the Netherworld to rebirth. The scenes on the coffin exterior wrap around Tentkhonsu, providing knowledge and protection for the journey ahead. The coffin's exterior paintings shield the mummy with magic spells and scenes of her journey to rebirth."}, {"label": "Notes", "content": "Additional color digital negative #s: NHB2011-01632 through NHB2011-01641; 2003-29027 through 2003-29051; 2003-31596 through 2003-31613."}, {"label": "Record Last Modified", "content": "1 Apr 2025"}, {"label": "Specimen Count", "content": "2"}], "place": [{"label": "Place", "content": "Qena, Upper Egypt, Egypt, Africa"}], "topic": [{"label": "Topic", "content": "Archaeology"}], "culture": [{"label": "Culture", "content": "Egyptian, III Intermediate Period, Dynasty XXI"}], "setName": [{"label": "See more items in", "content": "Anthropology"}], "dataSource": [{"label": "Data Source", "content": "NMNH - Anthropology Dept."}], "identifier": [{"label": "Accession Number", "content": "027543"}, {"label": "USNM Number", "content": "A154954-0"}], "objectType": [{"label": "Object Type", "content": "Coffin"}]}, "indexedStructured": {"date": ["1890s"], "name": ["Government Of Egypt"], "place": ["Qena", "Africa", "Egypt", "Upper Egypt"], "topic": ["Archaeology", "Anthropology"], "culture": ["Egyptian, III Intermediate Period, Dynasty XXI"], "geoLocation": [{"L1": {"type": "Continent", "content": "Africa"}, "L2": {"type": "Country", "content": "Egypt"}, "L3": {"type": "State", "content": "Upper Egypt"}, "L4": {"type": "County", "content": "Qena"}}], "object_type": ["Coffins"], "online_media_type": ["Images"]}, "descriptiveNonRepeating": {"guid": "http://n2t.net/ark:/65665/3e23f4663-76f5-4d4e-8635-fab2f6c23268", "title": {"label": "title", "content": "Inner Coffin & Lid Of Tentkhonsu"}, "record_ID": "nmnhanthropology_8026581", "unit_code": "NMNHANTHRO", "title_sort": "INNER COFFIN LID OF TENTKHONSU", "data_source": "NMNH - Anthropology Dept.", "record_link": "http://n2t.net/ark:/65665/3e23f4663-76f5-4d4e-8635-fab2f6c23268", "metadata_usage": {"access": "CC0"}}}, "hash": "4287dcce592cc14c766864e44ae7c2e03251eee4", "docSignature": "7f65deefad8d35bff6d363ac2fb5c12b", "timestamp": "1663781496", "lastTimeUpdated": "1744129113", "version": "1744114074"}], "facets": {}, "rowCount": 9, "message": "content found"}}